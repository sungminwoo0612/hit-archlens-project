# YOLO model weights
*.pt
# 기본 weights 폴더의 가중치는 포함
!weights/*.pt
# experiments의 weights 폴더 가중치는 포함
!experiments/*/weights/*.pt
# 실험 결과 runs 폴더의 가중치는 제외 (너무 큼)
experiments/*/runs/**/weights/*.pt

